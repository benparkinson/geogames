<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>com.parkinson.benjamin</groupId>
  <artifactId>geogames</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>geogames</name>
  <description>Geography games and quizzes</description>
  <properties>
    <java.version>25</java.version>

    <!--
      Switches so each CI job runs exactly one thing. All default to "run everything", so a plain
      `mvn verify` still builds, lints and tests all of it.
        -DskipTests      skips every test, Java and frontend (the usual Maven switch)
        -DskipUnitTests  skips Surefire and the frontend `npm test` only
        -DskipITs        skips Failsafe (the *IT classes) only
        -Dskip.lint      skips `npm run lint` only
        -Dskip.frontend  skips Node, npm ci, lint, the Next build and the Vitest run (see the
                         `skip-frontend` profile below); needs client/out for a bundled jar
    -->
    <skipTests>false</skipTests>
    <skipUnitTests>${skipTests}</skipUnitTests>
    <skipITs>${skipTests}</skipITs>
    <skip.lint>false</skip.lint>
    <skip.frontend.tests>${skipUnitTests}</skip.frontend.tests>
    <!--
      JaCoCo's agent argument line goes to Surefire only (see the surefire configuration), so the
      coverage gate measures the unit tests alone. Empty by default so -Djacoco.skip=true leaves
      Surefire with no agent.
    -->
    <jacoco.surefire.argLine></jacoco.surefire.argLine>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.zalando</groupId>
      <artifactId>logbook-spring-boot-starter</artifactId>
      <version>4.2.0</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.24.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipUnitTests}</skipTests>
          <argLine>@{jacoco.surefire.argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <!-- Runs the *IT classes (Spring Boot context and real-port tests). Version from the Boot parent. -->
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>2.0.2</version>
        <configuration>
          <workingDirectory>client</workingDirectory>
          <installDirectory>target</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install node and npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <!-- Keep in step with client/.nvmrc (CI's setup-node reads it); CI checks they match. -->
              <nodeVersion>v24.22.2</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm install</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm run lint</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <skip>${skip.lint}</skip>
              <arguments>run lint</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm run build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm test</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <skip>${skip.frontend.tests}</skip>
              <arguments>run test</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <configuration>
              <target>
                <copy todir="${project.build.directory}/classes/public">
                  <fileset dir="${project.basedir}/client/out" erroronmissingdir="false"/>
                </copy>
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <configuration>
          <excludes>
            <exclude>com/parkinson/benjamin/geogames/GeogamesApplication.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <!--
              The coverage gate counts the unit tests only: the agent is attached to Surefire
              (via jacoco.surefire.argLine) and not to Failsafe, so the *IT classes add nothing.
            -->
            <id>jacoco-prepare-agent</id>
            <configuration>
              <propertyName>jacoco.surefire.argLine</propertyName>
            </configuration>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.92</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.parkinson.benjamin.geogames.service</include>
                    <include>com.parkinson.benjamin.geogames.controllers</include>
                    <include>com.parkinson.benjamin.geogames.helper</include>
                    <include>com.parkinson.benjamin.geogames.api</include>
                    <include>com.parkinson.benjamin.geogames.model</include>
                    <include>com.parkinson.benjamin.geogames.config</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.97</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <!-- Mostly unused JPA setters and one geometry accessor: not worth testing. -->
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.parkinson.benjamin.geogames.model.geojson</include>
                    <include>com.parkinson.benjamin.geogames.dao</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.72</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>

          <java>
            <googleJavaFormat>
              <version>1.35.0</version>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        -Dskip.frontend=true: a backend-only build. One profile sets every switch of the
        frontend plugin together (the plugin's own skip.installnodenpm / skip.npm, plus our lint and
        Vitest switches, which are set per execution and so ignore skip.npm).
      -->
      <id>skip-frontend</id>
      <activation>
        <property>
          <name>skip.frontend</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <skip.installnodenpm>true</skip.installnodenpm>
        <skip.npm>true</skip.npm>
        <skip.lint>true</skip.lint>
        <skip.frontend.tests>true</skip.frontend.tests>
      </properties>
    </profile>
    <profile>
      <!--
        Regenerates the offline-built data into target/regen/ so scripts/check-processed-data.sh can
        compare it with src/main/resources/processed/. Runs the loaders in order at process-classes
        (after compile). TripointLoaderMain and WikidataMain are left out because they use the network.
        Use: ./mvnw -B -Pregenerate-data -Dskip.frontend -DskipTests -Djacoco.skip=true process-classes
      -->
      <id>regenerate-data</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.4</version>
            <configuration>
              <cleanupDaemonThreads>false</cleanupDaemonThreads>
            </configuration>
            <executions>
              <execution>
                <id>regen-countries</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.parkinson.benjamin.geogames.loaders.countries.CountryLoaderMain</mainClass>
                  <arguments>
                    <argument>geodata/countries/countries.geo.json</argument>
                    <argument>geodata/countries/additionalNames.json</argument>
                    <argument>geodata/countries/excludedNames.json</argument>
                    <argument>target/regen/countries</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>regen-country-shapes</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.parkinson.benjamin.geogames.loaders.countries.CountryShapeMain</mainClass>
                  <arguments>
                    <argument>target/regen/countries</argument>
                    <argument>target/regen/country-shapes</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>regen-rivers</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.parkinson.benjamin.geogames.loaders.rivers.RiverLoaderMain</mainClass>
                  <arguments>
                    <argument>geodata/rivers/naturalearth/ne_10m_rivers_lake_centerlines_scale_rank.geojson</argument>
                    <argument>geodata/rivers/wikidata.json</argument>
                    <argument>geodata/rivers/overrides.json</argument>
                    <argument>target/regen/countries</argument>
                    <argument>target/regen/rivers</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>regen-lakes</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.parkinson.benjamin.geogames.loaders.lakes.LakeLoaderMain</mainClass>
                  <arguments>
                    <argument>geodata/lakes/naturalearth/ne_10m_lakes.geojson</argument>
                    <argument>geodata/lakes/wikidata.json</argument>
                    <argument>geodata/lakes/overrides.json</argument>
                    <argument>target/regen/countries</argument>
                    <argument>target/regen/lakes</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
